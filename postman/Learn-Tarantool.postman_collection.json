{
  "info": {
    "_postman_id": "e88061f7-b365-4a15-90ce-a2cdfce90ca0",
    "name": "Learn Tarantool - Effect API",
    "description": "Requests for the Effect v4 HTTP API and Better Auth. Run the Auth folder in order so Postman can retain the Better Auth session cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000", "type": "string"},
    {"key": "pageLimit", "value": "2", "type": "string"},
    {"key": "nextCursor", "value": "", "type": "string"},
    {"key": "filterAge", "value": "21", "type": "string"},
    {"key": "filterCreatedAt", "value": "0", "type": "string"},
    {"key": "authEmail", "value": "", "type": "string"},
    {"key": "authPassword", "value": "secure-password-123", "type": "string"},
    {"key": "verificationToken", "value": "paste-token-from-email", "type": "string"},
    {"key": "verificationCallbackUrl", "value": "http://localhost:3000/health", "type": "string"},
    {"key": "userId", "value": "", "type": "string"},
    {"key": "sessionToken", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"]},
            "description": "Checks the Effect v4 BunPlatform HTTP server."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('server reports healthy', () => pm.expect(pm.response.json().data.status).to.eql('ok'));"
          ]}}]
        },
        {
          "name": "OpenAPI Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/openapi.json", "host": ["{{baseUrl}}"], "path": ["openapi.json"]},
            "description": "Generated automatically from the Effect HttpApi schemas."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('OpenAPI 3.1 document', () => pm.expect(pm.response.json().openapi).to.eql('3.1.0'));"
          ]}}]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users - First Page",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{sessionToken}}", "type": "string"}]},
            "url": {
              "raw": "{{baseUrl}}/api/users?limit={{pageLimit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [{"key": "limit", "value": "{{pageLimit}}"}]
            },
            "description": "Starts deterministic pagination ordered by immutable [created_at, id]. Treat next_cursor as opaque; the test validates its boundary and saves it as nextCursor."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const page = pm.response.json().data;",
            "pm.test('response contains complete user objects', () => { pm.expect(page.items).to.be.an('array'); if (page.items.length > 0) pm.expect(page.items[0]).to.include.keys('id', 'email', 'name', 'age', 'created_at'); });",
            "pm.test('pagination metadata is present', () => pm.expect(page).to.include.keys('next_cursor', 'has_more', 'totalPage', 'currentPage'));",
            "pm.test('next cursor matches the final [created_at, id] boundary', () => {",
            "  if (page.next_cursor === null) return;",
            "  pm.expect(page.items.length).to.be.greaterThan(0);",
            "  pm.expect(page.next_cursor).to.match(/^u1:\\d+:\\d+:\\d+$/);",
            "  const [, createdAt, id] = page.next_cursor.split(':').map(Number);",
            "  const last = page.items[page.items.length - 1];",
            "  pm.expect([createdAt, id]).to.eql([last.created_at, last.id]);",
            "});",
            "pm.collectionVariables.set('nextCursor', page.next_cursor || '');"
          ]}}]
        },
        {
          "name": "List Users - Next Page",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{sessionToken}}", "type": "string"}]},
            "url": {
              "raw": "{{baseUrl}}/api/users?limit={{pageLimit}}&cursor={{nextCursor}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {"key": "limit", "value": "{{pageLimit}}"},
                {"key": "cursor", "value": "{{nextCursor}}"}
              ]
            },
            "description": "Uses the opaque cursor saved by the first-page request. The cursor represents the immutable logical [created_at, id] boundary, so users created in the same second continue by primary ID without skips or duplicates."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const requestCursor = pm.collectionVariables.get('nextCursor');",
            "const page = pm.response.json().data;",
            "pm.test('request used a [created_at, id] cursor', () => pm.expect(requestCursor).to.match(/^u1:\\d+:\\d+:\\d+$/));",
            "pm.test('items are strictly after the requested composite boundary', () => {",
            "  const [, boundaryCreatedAt, boundaryId] = requestCursor.split(':').map(Number);",
            "  for (const item of page.items) {",
            "    pm.expect(item.created_at > boundaryCreatedAt || (item.created_at === boundaryCreatedAt && item.id > boundaryId)).to.eql(true);",
            "  }",
            "  for (let index = 1; index < page.items.length; index += 1) {",
            "    const previous = page.items[index - 1];",
            "    const current = page.items[index];",
            "    pm.expect(current.created_at > previous.created_at || (current.created_at === previous.created_at && current.id > previous.id)).to.eql(true);",
            "  }",
            "});",
            "pm.test('next cursor matches the final [created_at, id] boundary', () => {",
            "  if (page.next_cursor === null) return;",
            "  pm.expect(page.items.length).to.be.greaterThan(0);",
            "  pm.expect(page.next_cursor).to.match(/^u1:\\d+:\\d+:\\d+$/);",
            "  const [, createdAt, id] = page.next_cursor.split(':').map(Number);",
            "  const last = page.items[page.items.length - 1];",
            "  pm.expect([createdAt, id]).to.eql([last.created_at, last.id]);",
            "});",
            "pm.collectionVariables.set('nextCursor', page.next_cursor || '');"
          ]}}]
        },
        {
          "name": "Filter Users by Age",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{sessionToken}}", "type": "string"}]},
            "url": {
              "raw": "{{baseUrl}}/api/users?age={{filterAge}}&limit={{pageLimit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {"key": "age", "value": "{{filterAge}}"},
                {"key": "limit", "value": "{{pageLimit}}"}
              ]
            },
            "description": "Uses the same list endpoint to match an exact age. Results are ordered by [age, id], and any returned cursor is bound to the filter."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const filterAge = Number(pm.variables.get('filterAge'));",
            "const page = pm.response.json().data;",
            "pm.test('all users satisfy the exact age filter', () => { for (const item of page.items) pm.expect(item.age).to.eql(filterAge); });",
            "pm.test('filtered pagination does not run an exact count', () => pm.expect(page.totalPage).to.eql(null));",
            "pm.test('age cursor matches the filter and final ID boundary', () => {",
            "  if (page.next_cursor === null) return;",
            "  pm.expect(page.next_cursor).to.match(/^ua1:\\d+:\\d+:\\d+$/);",
            "  const [, cursorAge, id] = page.next_cursor.split(':').map(Number);",
            "  const last = page.items[page.items.length - 1];",
            "  pm.expect([cursorAge, id]).to.eql([filterAge, last.id]);",
            "});"
          ]}}]
        },
        {
          "name": "Filter Users by Created At",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{sessionToken}}", "type": "string"}]},
            "url": {
              "raw": "{{baseUrl}}/api/users?createdAt={{filterCreatedAt}}&limit={{pageLimit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {"key": "createdAt", "value": "{{filterCreatedAt}}"},
                {"key": "limit", "value": "{{pageLimit}}"}
              ]
            },
            "description": "Uses the same list endpoint to match an exact Unix created_at timestamp. Set filterCreatedAt to a value present in the users space."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const filterCreatedAt = Number(pm.variables.get('filterCreatedAt'));",
            "const page = pm.response.json().data;",
            "pm.test('all users satisfy the createdAt filter', () => { for (const item of page.items) pm.expect(item.created_at).to.eql(filterCreatedAt); });",
            "pm.test('filtered pagination does not run an exact count', () => pm.expect(page.totalPage).to.eql(null));"
          ]}}]
        },
        {
          "name": "Filter Users by Age and Created At",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{sessionToken}}", "type": "string"}]},
            "url": {
              "raw": "{{baseUrl}}/api/users?age={{filterAge}}&createdAt={{filterCreatedAt}}&limit={{pageLimit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"],
              "query": [
                {"key": "age", "value": "{{filterAge}}"},
                {"key": "createdAt", "value": "{{filterCreatedAt}}"},
                {"key": "limit", "value": "{{pageLimit}}"}
              ]
            },
            "description": "Combines both exact filters using the [age, created_at, id] index."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const filterAge = Number(pm.variables.get('filterAge'));",
            "const filterCreatedAt = Number(pm.variables.get('filterCreatedAt'));",
            "const page = pm.response.json().data;",
            "pm.test('all users satisfy both filters', () => {",
            "  for (const item of page.items) pm.expect([item.age, item.created_at]).to.eql([filterAge, filterCreatedAt]);",
            "});",
            "pm.test('filtered pagination does not run an exact count', () => pm.expect(page.totalPage).to.eql(null));",
            "pm.test('combined cursor is bound to both filters', () => {",
            "  if (page.next_cursor === null) return;",
            "  pm.expect(page.next_cursor).to.match(/^uac1:\\d+:\\d+:\\d+:\\d+$/);",
            "  const [, cursorAge, cursorCreatedAt] = page.next_cursor.split(':').map(Number);",
            "  pm.expect([cursorAge, cursorCreatedAt]).to.eql([filterAge, filterCreatedAt]);",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Postman automatically stores the better-auth.session_token cookie returned by sign-up/sign-in.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Better Auth requires an Origin/Referer when a retained cookie is sent.",
              "pm.request.headers.upsert({ key: 'Origin', value: pm.variables.get('baseUrl') });"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Sign Up with Email",
          "event": [
            {"listen": "prerequest", "script": {"exec": [
              "if (!pm.collectionVariables.get('authEmail')) {",
              "  pm.collectionVariables.set('authEmail', `postman-${Date.now()}@example.com`);",
              "}"
            ]}},
            {"listen": "test", "script": {"exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json().data;",
              "pm.collectionVariables.set('userId', result.user.id);",
              "pm.test('user awaits verification', () => { pm.expect(result.token).to.eql(null); pm.expect(result.user.emailVerified).to.eql(false); });"
            ]}}
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Postman Learner\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"callbackURL\": \"{{verificationCallbackUrl}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/api/auth/sign-up/email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sign-up", "email"]}
          }
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"callbackURL\": \"{{verificationCallbackUrl}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/api/auth/send-verification-email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "send-verification-email"]},
            "description": "Sends another real verification email through the configured SMTP provider."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Verify Email with Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email?token={{verificationToken}}&callbackURL={{verificationCallbackUrl}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"],
              "query": [
                {"key": "token", "value": "{{verificationToken}}"},
                {"key": "callbackURL", "value": "{{verificationCallbackUrl}}"}
              ]
            },
            "description": "Normally the recipient clicks the email link. For manual testing, copy only its token query value into verificationToken."
          }
        },
        {
          "name": "Sign In with Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/api/auth/sign-in/email", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sign-in", "email"]}
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const result = pm.response.json().data;",
            "pm.collectionVariables.set('userId', result.user.id);",
            "pm.collectionVariables.set('sessionToken', result.token);"
          ]}}]
        },
        {
          "name": "Get Current Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/api/auth/get-session", "host": ["{{baseUrl}}"], "path": ["api", "auth", "get-session"]},
            "description": "Uses the session cookie retained by Postman's cookie jar."
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.test('session belongs to saved user', () => pm.expect(pm.response.json().data.user.id).to.eql(pm.collectionVariables.get('userId')));"
          ]}}]
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Origin", "value": "{{baseUrl}}"}
            ],
            "body": {"mode": "raw", "raw": "{}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{baseUrl}}/api/auth/sign-out", "host": ["{{baseUrl}}"], "path": ["api", "auth", "sign-out"]}
          },
          "event": [{"listen": "test", "script": {"exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('sessionToken', '');"
          ]}}]
        }
      ]
    }
  ]
}

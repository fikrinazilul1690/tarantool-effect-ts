TARANTOOL_HOST=127.0.0.1
TARANTOOL_PORT=3301
TARANTOOL_ROUTERS=127.0.0.1:3301,127.0.0.1:3304
TARANTOOL_USER=app
TARANTOOL_PASSWORD=app-secret
TARANTOOL_CONNECT_TIMEOUT_MS=5000
TARANTOOL_MAX_IN_FLIGHT=256
TARANTOOL_MAX_IN_FLIGHT_PER_ROUTER=128
TARANTOOL_CIRCUIT_FAILURE_THRESHOLD=3
TARANTOOL_CIRCUIT_RESET_MS=5000
TARANTOOL_OPERATION_TIMEOUT_MS=4000
TARANTOOL_SHUTDOWN_DRAIN_MS=10000
HTTP_REQUEST_TIMEOUT_MS=5000
HTTP_GRACEFUL_SHUTDOWN_MS=15000
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
AUTH_DEBUG=false

# Real SMTP delivery. Gmail requires 2-Step Verification and an App Password.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="Learn Tarantool your-email@gmail.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace-with-16-characters-app-password
EMAIL_WORKER_POLL_MS=500
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_CONCURRENCY=5
EMAIL_LEASE_MS=60000
EMAIL_SEND_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=8
EMAIL_RETRY_BASE_MS=1000
EMAIL_RETRY_MAX_MS=300000

TARANTOOL_HOST=127.0.0.1
TARANTOOL_PORT=3301
TARANTOOL_USER=app
TARANTOOL_PASSWORD=app-secret
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
AUTH_DEBUG=false

# Real SMTP delivery. Gmail requires 2-Step Verification and an App Password.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="Learn Tarantool your-email@gmail.com"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=replace-with-16-characters-app-password
